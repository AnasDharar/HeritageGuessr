# Server-only configuration. Never prefix any of these variables with NEXT_PUBLIC_.
GROQ_API_KEY=your_groq_api_key
# Optional; defaults to llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile
# Required in production: use a long, random value to sign opaque round tokens.
GAME_SESSION_SECRET=replace_with_a_long_random_secret
